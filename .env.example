# ==============================================================
# Buddy AI — Backend Server Environment Variables
# Copy to .env for local development
# In production (Cloud Run), set these via deployment config instead
# NEVER commit .env or firebase.json to git
# ==============================================================

# Server Configuration
PORT=8080
ENV=production

# Google Cloud Platform & Firebase Configuration
GCP_PROJECT_ID=buddy-2b92f
# In production: leave FIREBASE_CREDENTIALS_FILE empty — Application Default
# Credentials (ADC) from the Cloud Run service's own identity will be used instead.
# In development: point to your local service account key file.
FIREBASE_CREDENTIALS_FILE=./firebase.json
FIRESTORE_DATABASE_ID=buddy-db

# Vertex AI / Gemini Configuration
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Live Talk model (must be deployed in your project)
VERTEX_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# Development Mode (true: allows offline testing with dev tokens; forced false
# whenever ENV=production regardless of this value)
AUTH_DEV_MODE=false

# Security & Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# CORS — comma-separated list of allowed frontend origins (no trailing slash).
# In production, set this to your real Firebase Hosting domain (and any custom
# domain). Also used to validate WebSocket upgrade Origin header.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://buddy-2b92f.web.app
